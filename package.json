{
  "name": "vyotiq",
  "version": "1.0.0",
  "description": "Vyotiq Agent V — lean NL harness desktop coding agent",
  "packageManager": "pnpm@11.17.0",
  "main": "./out/main/index.js",
  "author": "Vyotiq",
  "homepage": "https://vyotiq.com",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/main/e2e",
    "test:watch": "vitest",
    "lint": "eslint .",
    "start": "electron-vite preview",
    "pack": "pnpm build && electron-builder --win --mac --linux",
    "pack:win": "pnpm build && electron-builder --win",
    "pack:mac": "pnpm build && electron-builder --mac",
    "pack:linux": "pnpm build && electron-builder --linux",
    "sync:provider-icons": "node scripts/sync-provider-brand-paths.mjs",
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@lobehub/icons": "^5.15.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/electron": "^7.15.0",
    "@sentry/react": "10.62.0",
    "@tanstack/react-virtual": "^3.14.8",
    "electron-log": "^5.4.4",
    "gpt-tokenizer": "^3.4.0",
    "lucide-react": "^1.27.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "tree-kill": "^1.2.2",
    "unpdf": "^1.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^7.2.6",
    "vitest": "^3.2.7"
  }
}
